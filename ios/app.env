# Per-app config — see SPEC.md "app.env contract". Secrets NEVER go here — they
# come from ~/.secrets (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH, SUDO_MINI).

APP_NAME=CuantoSocials                # display / product name
SCHEME=CuantoSocials                  # xcodebuild scheme
PROJECT=CuantoSocials.xcodeproj       # generated by xcodegen from Project.yml
BUNDLE_ID=com.cuantolabs.socials
TEAM_ID=8AWCD3T4B5
ASC_APP_ID=6813092005                 # numeric, filled after the app record exists in ASC
DEVICE_FAMILY="iphone"                # 1=iPhone, 2=iPad ("1,2" for a universal app)
PROFILE_APPSTORE="CuantoSocials App Store"
PROFILE_DEV="CuantoSocials Development"
SIGN_CERT_SHA1=293CF99CF43400F2BB943AD867D3EE5A8AE71AD4 # 40-char fingerprint — ios-sign fills this
SIM_IPHONE="iPhone 17 Pro Max"         # 6.9" screenshot device
ENV_PREFIX=SOCIALS                    # app's DEBUG env var prefix, e.g. SOCIALS_DEV_EMAIL
METADATA_DIR=AppStore                 # listing, review notes, screenshots
